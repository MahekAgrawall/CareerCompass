# ── AI (optional) ─────────────────────────────────────────────────────────────
# Leave blank to run without AI: roadmap + copilot endpoints return 503 and the
# rest of the app keeps working. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Which Gemini model to call. The default is a floating "latest" alias — set a
# dated id here to pin the behaviour (every saved roadmap records the model it
# was generated with either way).
# GEMINI_MODEL=gemini-flash-lite-latest

# The AI endpoints (roadmap, copilot, match explanation) spend a paid quota and
# are open to guests, so each caller gets a budget per rolling window — keyed by
# user id when signed in, otherwise by client address. Over budget is a 429; the
# ranked matches never depend on the AI, so /match simply drops its written
# assessment instead of failing.
# AI_RATE_LIMIT=15
# AI_RATE_WINDOW_SECONDS=60

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# There is no default. The API refuses to start if this is missing, shorter than
# 32 characters, or a known placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── Semantic role index (optional) ────────────────────────────────────────────
# Matching has two stages: role candidates are recalled from a Qdrant vector
# index, then scored and explained by the same transparent 65/35 formula as ever.
# Recall is what lets a role surface on meaning ("I like maths and cloud") rather
# than only on identical interest chips.
#
# The index is built by an explicit migration (`python -m scripts.ingest_roles`),
# never at startup; until it has been run, matching is keyword-only exactly as
# before.
#
# auto (default) = Gemini when GEMINI_API_KEY is set, otherwise the offline
# deterministic embedder. Each provider (and Gemini model) gets its own
# collection, and the provider that built the index is recorded next to it, so
# nothing ever compares vectors from two different spaces.
# EMBEDDING_PROVIDER=auto
#
# Which Gemini embedding model to use (it is part of the collection name).
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
#
# Embedded Qdrant lives here (defaults to backend/data/qdrant). Point QDRANT_URL
# at a Qdrant server instead — with QDRANT_API_KEY if it needs one — to share one
# index between machines.
# QDRANT_PATH=
# QDRANT_URL=
# QDRANT_API_KEY=
