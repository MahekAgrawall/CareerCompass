# ── AI (optional) ─────────────────────────────────────────────────────────────
# Leave blank to run without AI: roadmap + copilot endpoints return 503 and the
# rest of the app keeps working. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# There is no default. The API refuses to start if this is missing, shorter than
# 32 characters, or a known placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
